# 环境变量配置
# 数据库类型：使用SQLite而不是MySQL
DATABASE_TYPE=sqlite

# Flask应用配置
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# 服务器配置
PORT=5000
HOST=0.0.0.0

# JWT配置
JWT_SECRET_KEY=jwt-secret-string

# 其他可选配置
# 数据库URL（如果使用自定义数据库）
# DATABASE_URL=sqlite:///instance//sports_booking.db

# MySQL配置（仅在需要MySQL时启用）
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/sports_booking

# 邮件配置
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-password

# 微信小程序配置
# WECHAT_APP_ID=your-app-id
# WECHAT_APP_SECRET=your-app-secret